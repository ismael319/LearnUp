# Copie este arquivo para .env e troque os valores por segredos longos e aleatorios.
# Sem estes dois, o docker compose nao sobe a API.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio-de-64-caracteres
JWT_REFRESH_SECRET=troque-por-outro-texto-longo-e-aleatorio-de-64-caracteres
COOKIE_SECURE=false
NODE_ENV=development
