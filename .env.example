# Necessário para `docker compose up`. Gere dois valores longos e diferentes.
JWT_SECRET=substitua-por-um-segredo-aleatorio-com-ao-menos-32-caracteres
JWT_REFRESH_SECRET=substitua-por-outro-segredo-aleatorio-com-ao-menos-32-caracteres

# Em produção use NODE_ENV=production, COOKIE_SECURE=true e HTTPS no proxy.
NODE_ENV=development
COOKIE_SECURE=false
