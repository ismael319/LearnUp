{
  "name": "learnup-backend",
  "version": "1.0.0",
  "private": true,
  "description": "LearnUp - API de plataforma de cursos online (Node.js + Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js up",
    "migrate:down": "node src/db/migrate.js down",
    "migrate:status": "node src/db/migrate.js status",
    "seed": "node src/db/seed.js",
    "seed:clean": "node src/db/seed.js --clean",
    "db:reset": "node src/db/migrate.js reset && node src/db/seed.js",
    "db:reset:clean": "node src/db/migrate.js reset && node src/db/seed.js --clean",
    "db:test:prepare": "node --env-file=.env.test src/db/prepare-test-db.js",
    "test": "npm run db:test:prepare && node --env-file=.env.test --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:only": "node --env-file=.env.test --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0"
  }
}
