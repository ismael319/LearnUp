# ==========================================
# LearnUp API - variáveis de ambiente
# Copie para `.env` e ajuste: cp .env.example .env
# ==========================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL=postgres://learnup:learnup@localhost:5432/learnup
PGSSL=false
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000

# --- Autenticação (JWT) ---
# Troque estes valores em produção! Mínimo de 32 caracteres.
JWT_SECRET=dev-secret-access-token-troque-em-producao-0001
JWT_REFRESH_SECRET=dev-secret-refresh-token-troque-em-producao-0002
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=10

# --- HTTP ---
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=false
# true | false | auto ("auto" liga fora de NODE_ENV=test).
# Em "test" o rate limit é desligado para a suíte não se auto-bloquear.
RATE_LIMIT=auto

# --- Pagamentos ---
# Provedores disponíveis: mock | stripe | mercadopago
# "mock" simula o checkout localmente (sem precisar de chaves reais).
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=BRL

# Stripe (cartão)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/pagamento/sucesso
STRIPE_CANCEL_URL=http://localhost:5173/catalogo

# Mercado Pago (Pix + cartão + boleto)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
