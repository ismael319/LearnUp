# ==========================================
# LearnUp API - ambiente de TESTES
# Sobrepõe o `.env` (ver package.json, script `test`).
#
# Objectivo: a suíte E2E nunca pode tocar na base real. Duas protecções:
#   1. aponta para outro banco (learnup_test);
#   2. usa a porta 4100, para nunca se ligar a um servidor de desarrollo
#      que esteja a correr na 4000 — era isso que sujava os dados reais.
# ==========================================

NODE_ENV=test
PORT=4100
API_URL=http://localhost:4100/api/v1

DATABASE_URL=postgres://learnup:learnup@localhost:5432/learnup_test
RATE_LIMIT=false
PAYMENT_PROVIDER=mock
